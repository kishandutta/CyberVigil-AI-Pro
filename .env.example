# CyberVigil AI Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas connection URI:
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/cybervigil?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:cybervigil2026@cluster0.mongodb.net/cybervigil?retryWrites=true&w=majority

# Fallback Mode: 'auto' will gracefully use in-memory store if MongoDB fails or is not connected
DB_FALLBACK=true

